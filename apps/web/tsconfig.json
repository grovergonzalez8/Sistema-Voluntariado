{
  "extends": "@sistema-voluntariado/typescript-config/react.json",
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "baseUrl": ".",
    "noEmit": true,
    "paths": {
      "@app/*": ["src/app/*"],
      "@modules/*": ["src/modules/*"],
      "@shared/*": ["src/shared/*"]
    },
    "types": ["vite/client", "vitest/globals"]
  },
  "include": [
    "src",
    "tests",
    "playwright.config.ts",
    "playwright-local-environment.ts",
    "playwright-local-environment.test.ts",
    "vite.config.ts",
    "vitest.integration.config.ts",
    "vitest.functions.config.ts",
    "vitest.unit.config.ts"
  ]
}
