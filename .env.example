# URL del entorno local o remoto de Supabase. No incluir credenciales reales.
VITE_SUPABASE_URL=

# Clave pública/anon de Supabase. Su seguridad depende de RLS correcta.
VITE_SUPABASE_ANON_KEY=

# Identificador para operaciones de administración fuera del navegador.
SUPABASE_PROJECT_ID=

# Nunca cree una variable VITE_ para service_role.
